# Secrets
secrets.yaml

# Nabu Casa cloud credentials
.cloud/

# Database and logs
*.db
*.db-shm
*.db-wal
*.log
home-assistant.log*

# Runtime state
.HA_VERSION
.ha_run.lock

# SSH keys
.ssh/

# Cache and temp
__pycache__/
*.pyc
tts/
.uuid
image/

# Zigbee database (binary, changes constantly)
zigbee.db*

# Storage - exclude most but keep important registries and dashboards
.storage/*
!.storage/core.area_registry
!.storage/lovelace*

# Never track secret-heavy HA integration config
.storage/core.config_entries

# ignore cache
.cache/
**/.cache/
deps/
.gitignore.bak.*
.storage/core.device_registry
.storage/core.entity_registry
